{
  "name": "phantomforge",
  "private": true,
  "version": "0.1.0",
  "description": "PhantomForge - a lead-automation platform built on browser automation",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @pf/db run generate",
    "db:migrate": "pnpm --filter @pf/db run migrate",
    "db:push": "pnpm --filter @pf/db run push",
    "db:studio": "pnpm --filter @pf/db run studio",
    "db:seed": "pnpm --filter @pf/db run seed",
    "setup": "pnpm install && pnpm infra:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
