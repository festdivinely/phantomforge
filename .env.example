# ---------------------------------------------------------------------------
# PhantomForge environment
# Copy to .env and fill in.  Never commit .env.
# Generate secrets with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Database (matches infra/docker-compose.yml) ---------------------------
DATABASE_URL=postgresql://phantomforge:phantomforge@localhost:5432/phantomforge?schema=public

# --- Redis (queue + cache) -------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Encryption ------------------------------------------------------------
# 32-byte base64 key used to encrypt stored platform session cookies at rest.
# LOSING THIS KEY MAKES EVERY STORED IDENTITY UNREADABLE.
PF_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# --- Auth (better-auth) ----------------------------------------------------
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# --- Service URLs / ports --------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# --- Object storage (RustFS locally, S3 in production) ----------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=phantomforge
S3_ACCESS_KEY_ID=phantomforge
S3_SECRET_ACCESS_KEY=phantomforge
S3_FORCE_PATH_STYLE=true

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true
# Milliseconds a run may take before it is force-killed
RUN_TIMEOUT_MS=900000

# --- Quota governor defaults (per identity, per day) -----------------------
# Deliberately conservative. These are the guard rails that keep automation
# from looking like automation. Raise them knowingly, not by accident.
QUOTA_CONNECTIONS_PER_DAY=20
QUOTA_MESSAGES_PER_DAY=30
QUOTA_PROFILE_VIEWS_PER_DAY=80
QUOTA_POSTS_PER_DAY=3
# Randomised delay window between individual actions, milliseconds
PACING_MIN_MS=8000
PACING_MAX_MS=25000
